# Database
DATABASE_URL=postgresql://shopnest:shopnest123@localhost:5432/shopnest_db

# JWT
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Razorpay (TEST mode - get keys from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# Use MOCK gateway when Razorpay keys are not available (set to true for demo)
MOCK_GATEWAY=true

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# App / Public URL
# PUBLIC_URL is the canonical URL of this service (auto-added to ALLOWED_ORIGINS).
# On Render, RENDER_EXTERNAL_URL is injected automatically — no need to set it.
BASE_URL=http://localhost:4000
PUBLIC_URL=http://localhost:4000

# CORS / CSRF Origin Guard
# Comma-separated list of additional origins allowed to make state-mutating
# requests (POST, PUT, PATCH, DELETE).  The server's own host (from
# X-Forwarded-Host / Host) and PUBLIC_URL are always allowed automatically.
# Example for multi-domain setups:
#   ALLOWED_ORIGINS=https://shopnest.onrender.com,https://admin.shopnest.com
ALLOWED_ORIGINS=

# AI Vision & Visual Search
ENABLE_AI_IMAGE=true
AI_PROVIDER=mock # mock | gemini | anthropic
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Google OAuth 2.0 PKCE Flow
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Frontend Feature Flags
VITE_SHOW_DEMO_LOGINS=false
