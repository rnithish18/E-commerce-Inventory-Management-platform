# Database
DATABASE_URL=postgresql://shopnest:shopnest123@localhost:5432/shopnest_db
TEST_DATABASE_URL=postgresql://shopnest:shopnest123@localhost:5432/shopnest_test_db

# JWT & Security
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_EXPIRES_IN=7d

# Server & Client
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Razorpay (TEST mode - mock fallback enabled when MOCK_GATEWAY=true)
RAZORPAY_KEY_ID=rzp_test_MOCK_KEY_ID
RAZORPAY_KEY_SECRET=MOCK_SECRET_KEY
RAZORPAY_WEBHOOK_SECRET=MOCK_WEBHOOK_SECRET
MOCK_GATEWAY=true

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
BASE_URL=http://localhost:4000

# Invoice & Tax (Leave unset to produce prominently labeled DEMO INVOICE)
SELLER_GSTIN=

# Email / SMTP (Leave unset to use labeled Dev Console Mailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ShopNest <orders@shopnest.com>

# Google OAuth 2.0 & Google One Tap / GIS (Leave unset to keep Google Login button hidden)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Facebook / Meta Login (Leave unset to keep Facebook button hidden)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4000/api/v1/auth/facebook/callback

# GitHub OAuth App (Leave unset to keep GitHub button hidden)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/api/v1/auth/github/callback

# Phone OTP (+91) via Twilio or MSG91 (In development, codes are logged to console labeled [DEV SMS] when credentials are unset)
ENABLE_PHONE_OTP=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# Email Magic Link (Single-use 15-minute token with browser cookie binding)
ENABLE_MAGIC_LINK=true
