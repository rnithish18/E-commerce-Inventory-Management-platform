# Database
DATABASE_URL=postgresql://shopnest:shopnest123@localhost:5432/shopnest_db
TEST_DATABASE_URL=postgresql://shopnest:shopnest123@localhost:5432/shopnest_test_db

# JWT & Security
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_EXPIRES_IN=7d

# Server & Client
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Razorpay (TEST mode - mock fallback enabled when MOCK_GATEWAY=true)
RAZORPAY_KEY_ID=rzp_test_MOCK_KEY_ID
RAZORPAY_KEY_SECRET=MOCK_SECRET_KEY
RAZORPAY_WEBHOOK_SECRET=MOCK_WEBHOOK_SECRET
MOCK_GATEWAY=true

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
BASE_URL=http://localhost:4000

# Invoice & Tax (Leave unset to produce prominently labeled DEMO INVOICE)
SELLER_GSTIN=

# Email / SMTP (Leave unset to use labeled Dev Console Mailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ShopNest <orders@shopnest.com>

# Google OAuth 2.0 (Leave unset to keep Google Login button hidden)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
